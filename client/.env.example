# Smart Parking Finder — Frontend Client Environment Configuration
# Copy this file to .env for local overrides, or set these variables in your Vercel Dashboard.

# Production Backend API URL (e.g., https://smart-parking-finder-api.onrender.com/api)
# For local development: http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: Google Maps JavaScript API Key
# If omitted or left empty, the application automatically uses the built-in Leaflet/OpenStreetMap fallback.
VITE_GOOGLE_MAPS_API_KEY=
