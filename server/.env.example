# ==============================================================================
# Smart Parking Finder — Backend Server Environment Configuration Template
# Copy this file to .env for local overrides, or set these variables in Render.
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (CORS)
# For production on Vercel: https://your-project.vercel.app
# Multiple origins can be comma-separated: https://app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# ==============================================================================
# Database Configuration
# ==============================================================================
# Set DB_CLIENT to:
# - 'auto'  : Tries MySQL on localhost:3306; auto-falls back to local SQLite if offline (ideal for local dev)
# - 'mysql' : Strictly enforces MySQL connection (REQUIRED in production mode on Render)
# - 'sqlite': Strictly uses local SQLite database
DB_CLIENT=auto

# Standard MySQL Parameters (Aiven / TiDB / Render MySQL / Railway / AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=smart_parking_db

# SSL/TLS for Cloud Hosted MySQL (Aiven, TiDB, Render require true)
DB_SSL=false

# Alternative: Single Connection String (optional, if your provider supplies DATABASE_URL)
# DATABASE_URL=mysql://username:password@hostname:3306/dbname

# ==============================================================================
# Authentication & Security
# ==============================================================================
# MANDATORY in production: Use a long, cryptographically random secret string.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h

# ==============================================================================
# Transactional Email (SMTP) Configuration (Nodemailer)
# ==============================================================================
# Leave empty for zero-configuration mode (notifications will safely be recorded as 'skipped')
# Compatible with Gmail App Passwords, SendGrid, Brevo, Mailgun, Amazon SES, or custom SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Smart Parking Finder" <no-reply@parkingfinder.com>

# Set to true to test email rendering with Nodemailer JSON stream transport without sending real emails
MOCK_SMTP=false

# ==============================================================================
# Automated Booking Reminders & Lifecycle
# ==============================================================================
# Advance notice in minutes before reservation start time to dispatch email reminder
REMINDER_MINUTES_BEFORE=15
REMINDER_CHECK_INTERVAL_SECONDS=60
